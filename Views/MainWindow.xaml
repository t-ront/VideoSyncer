<Window x:Class="VideoSyncer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:VideoSyncer.ViewModels"
  Title="VideoSyncer" Height="1000" Width="850" MinHeight="920" MinWidth="700" Background="#F1F5F9"
  FontFamily="Segoe UI, Meiryo">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#94A3B8" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="Background" Value="#FEF2F2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEE2E2" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="290" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="110" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Grid.Row="0" Margin="0,0,0,12" Padding="15">
            <StackPanel>
                <TextBlock Text="同期元動画" Style="{StaticResource HeaderTextStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Height="34" IsReadOnly="True" Text="{Binding BaseVideo}" />
                    <Button Content="動画を選択..." Grid.Column="1" Height="34" Width="110" Margin="10,0,0,0"
            Style="{StaticResource SecondaryButton}" Command="{Binding SelectBaseVideoCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Grid.Row="1" Margin="0,0,0,12" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="同期対象動画" Style="{StaticResource HeaderTextStyle}" Grid.Row="0" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC"
            ClipToBounds="True">
                        <ListBox x:Name="TargetVideoListBox" BorderThickness="0" Background="Transparent" AllowDrop="True"
              PreviewMouseLeftButtonDown="TargetVideoListBox_PreviewMouseLeftButtonDown"
              PreviewMouseMove="TargetVideoListBox_PreviewMouseMove" Drop="TargetVideoListBox_Drop"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding TargetVideos}"
              SelectedIndex="{Binding SelectedTargetIndex, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Padding="5,6" Cursor="SizeAll"
                    Foreground="#334155" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="2,2,2,0" />
                                    <Setter Property="Padding" Value="4" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Column="1" Width="120" Margin="15,0,0,0" VerticalAlignment="Top">
                        <Button Content="動画を追加..." Height="34" Margin="0,0,0,8" Style="{StaticResource SecondaryButton}"
              Command="{Binding AddTargetVideosCommand}" />
                        <Button Content="選択を削除" Height="34" Margin="0,0,0,16" Style="{StaticResource SecondaryButton}"
              Command="{Binding RemoveTargetVideoCommand}" />
                        <Button Content="▲ 上へ移動" Height="34" Margin="0,0,0,8" Style="{StaticResource SecondaryButton}"
              Command="{Binding MoveUpCommand}" />
                        <Button Content="▼ 下へ移動" Height="34" Margin="0,0,0,16" Style="{StaticResource SecondaryButton}"
              Command="{Binding MoveDownCommand}" />
                        <Button Content="リストクリア" Height="34" Style="{StaticResource DangerButton}"
              Command="{Binding ClearTargetVideosCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}" Grid.Row="2" Margin="0,0,0,12" Padding="15">
            <StackPanel>
                <TextBlock Text="出力先フォルダ" Style="{StaticResource HeaderTextStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Height="34" IsReadOnly="True" Text="{Binding OutputDir}" />
                    <Button Content="フォルダ変更..." Grid.Column="1" Height="34" Width="110" Margin="10,0,0,0"
            Style="{StaticResource SecondaryButton}" Command="{Binding SelectOutputDirCommand}" />
                    <Button Content="フォルダを開く" Grid.Column="2" Height="34" Width="110" Margin="10,0,0,0"
            Style="{StaticResource SecondaryButton}" Command="{Binding OpenOutputDirCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Grid.Column="0" Margin="0,0,8,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="出力解像度" Style="{StaticResource HeaderTextStyle}" />
                    <ComboBox Height="34" VerticalContentAlignment="Center" Margin="0,2,0,0" Foreground="#334155"
            SelectedIndex="{Binding ResolutionIndex}">
                        <ComboBoxItem Content="2160P(4K) - 3840x2160" />
                        <ComboBoxItem Content="1080P(FHD) - 1920x1080" />
                        <ComboBoxItem Content="720P(HD) - 1280x720" />
                        <ComboBoxItem Content="480P(SD) - 848x480" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="8,0,0,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="エンコード設定 (ハードウェアエンコード)" Style="{StaticResource HeaderTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton Content="なし (CPU)" Margin="0,0,20,0" Foreground="#334155"
              IsChecked="{Binding IsCpuSelected}" />
                        <RadioButton Content="NVIDIA" Margin="0,0,20,0" Foreground="#334155"
              IsChecked="{Binding IsNvidiaSelected}" />
                        <RadioButton Content="AMD" Margin="0,0,20,0" Foreground="#334155" IsChecked="{Binding IsAmdSelected}" />
                        <RadioButton Content="Intel" Foreground="#334155" IsChecked="{Binding IsIntelSelected}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Content="作成" Height="40" Grid.Column="0" Margin="0,0,12,0" Command="{Binding ExecuteCommand}"
        FontSize="16" FontWeight="Bold" Foreground="White" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" CornerRadius="8" Background="#4F46E5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#4F46E5" Opacity="0.3" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#3730A3" />
                                <Setter TargetName="BgBorder" Property="Margin" Value="0,1,0,-1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BgBorder" Property="Background" Value="#94A3B8" />
                                <Setter TargetName="BgBorder" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="キャンセル" Height="40" Width="130" Grid.Column="1" Command="{Binding CancelCommand}"
        IsEnabled="{Binding IsExecuting}" FontSize="15" FontWeight="Bold" Style="{StaticResource DangerButton}" />
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <ProgressBar Height="16" Minimum="0" Maximum="100" BorderThickness="0" Background="#E2E8F0" Foreground="#3B82F6"
          Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsIndeterminate}" />
            </Border>
            <TextBlock Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="#475569" FontWeight="SemiBold"
        Text="{Binding ProgressText}" />
        </Grid>

        <Border Grid.Row="6" CornerRadius="8" Background="#0F172A" ClipToBounds="True" BorderThickness="1"
      BorderBrush="#1E293B">
            <TextBox IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="Transparent"
        Foreground="#38BDF8" FontFamily="Consolas, Meiryo" Padding="12" BorderThickness="0"
        Text="{Binding LogText, Mode=OneWay}" />
        </Border>
    </Grid>
</Window>